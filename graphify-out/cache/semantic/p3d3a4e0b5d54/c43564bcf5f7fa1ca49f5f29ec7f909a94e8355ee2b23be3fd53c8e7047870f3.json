{"nodes": [{"id": "docs_annuaire_doc", "label": "Annuaire : mod\u00e8le de donn\u00e9es", "file_type": "document", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_annuaire_person", "label": "Table person", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Une personne est unique quel que soit le nombre de ses r\u00f4les (\u00e9l\u00e8ve, responsable, professeur)"}, {"id": "docs_annuaire_household", "label": "Table household (foyer payeur)", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le foyer est le payeur : cotisations, adresse postale et IBAN s'y rattachent, pas \u00e0 l'enfant"}, {"id": "docs_annuaire_household_member", "label": "Table household_member (responsable/\u00e0 charge)", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_annuaire_phone", "label": "Table phone", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_annuaire_external_ref", "label": "Table external_ref", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Une table plut\u00f4t qu'une colonne : une personne peut avoir deux num\u00e9ros (\u00e9l\u00e8ve et professeur) ; rend l'import rejouable sans doublons"}, {"id": "docs_annuaire_season", "label": "Table season / saison en cours", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saison en cours choisie dans les r\u00e9glages, pas d\u00e9duite de la date, car la r\u00e9inscription s'ouvre pendant la saison actuelle"}, {"id": "docs_annuaire_membership", "label": "Table membership (adh\u00e9sion)", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ce qui change chaque saison n'est pas sur la fiche ; l'adh\u00e9sion ne coupe aucun compte"}, {"id": "docs_annuaire_teacher", "label": "Table teacher (profil professeur)", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_annuaire_addressmixin", "label": "AddressMixin", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_annuaire_bank_account", "label": "Table bank_account (IBAN chiffr\u00e9)", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_annuaire_sepa_mandate", "label": "Table sepa_mandate", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pas de document de mandat stock\u00e9 ; suppression 13 mois apr\u00e8s le dernier pr\u00e9l\u00e8vement"}, {"id": "docs_annuaire_bank_data_keys", "label": "BANK_DATA_KEYS (cl\u00e9 d\u00e9di\u00e9e)", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distincte de SECRET_KEY : changer SECRET_KEY ne doit pas faire perdre les IBAN, et une fuite de l'une ne donne pas l'autre"}, {"id": "docs_annuaire_aes_gcm_encryption", "label": "Chiffrement AES-GCM avec foyer en donn\u00e9es associ\u00e9es", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Un chiffr\u00e9 recopi\u00e9 d'une ligne \u00e0 l'autre ne se d\u00e9chiffre plus ; prot\u00e8ge d'une fuite de la base, pas d'une prise de contr\u00f4le du serveur"}, {"id": "docs_annuaire_iban_fingerprint", "label": "Empreinte HMAC des IBAN", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rep\u00e9rer un m\u00eame IBAN sur deux foyers et rejouer l'import sans rien d\u00e9chiffrer ; d\u00e9riv\u00e9e de BANK_DATA_KEYS plut\u00f4t que d'une troisi\u00e8me cl\u00e9"}, {"id": "docs_annuaire_secure_mode", "label": "Mode s\u00e9curis\u00e9 (TOTP < 10 min) et droit bank.view", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_annuaire_bank_rotate_key", "label": "flask bank-rotate-key", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "code"}, {"id": "docs_annuaire_fusion_fiches", "label": "Fusion de deux fiches", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_annuaire_person_account_id", "label": "Lien person.account_id", "file_type": "concept", "source_file": "docs/annuaire.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Le sens du lien ne change rien (0 ou 1 compte par