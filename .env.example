# Clé secrète Flask : générer avec `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=change-moi
# URL publique (utilisée dans les emails)
BASE_URL=http://localhost:8001
# Identité du serveur OIDC (par défaut BASE_URL). À choisir avant de brancher une appli : elle ne doit plus changer.
# OIDC_ISSUER=https://compte.example.org
# Nom par défaut : modifiable ensuite dans Paramètres → Apparence
ASSO_NAME=Mon association
# Dossier des données (base et logo) : /data dans Docker, ./data en développement
DATA_DIR=/data
# Fuseau horaire des dates affichées
TZ=Europe/Paris
# Mettre à 1 derrière un reverse proxy (Caddy, Traefik, nginx) qui ajoute X-Forwarded-*
TRUST_PROXY=0
# Adresse d'écoute (Docker) : 127.0.0.1 si le proxy est sur ce serveur,
# sinon l'IP privée vue par le proxy. Jamais 0.0.0.0 sur une IP publique.
BIND_ADDR=127.0.0.1
# Clés de chiffrement des IBAN, distinctes de SECRET_KEY : générer avec `flask bank-generate-key`.
# Sauvegarder à part de la base : sans elles, les IBAN enregistrés sont perdus.
BANK_DATA_KEYS=
# Content-Security-Policy : 0 = appliquée (défaut), 1 = Report-Only, pour diagnostiquer sans rien bloquer.
CSP_REPORT_ONLY=0

# SMTP (facultatif — sans SMTP, les notifications restent dans l'appli)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
